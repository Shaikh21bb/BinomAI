# === APP SETTINGS ===
APP_NAME="BINOM AI"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# === DATABASE (Supabase) ===
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_KEY=your-local-service-key
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# === AUTH ===
SUPABASE_JWT_SECRET=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === REDIS ===
# DB 0 for Celery, DB 1 for Cache, DB 2 for PubSub, DB 3 for Rate Limits
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# === AI APIS ===
GOOGLE_AI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Primary and Fallback models
PRIMARY_LLM_MODEL=gemini-1.5-pro
FALLBACK_LLM_MODEL=gpt-4o

# LLM Parameters
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# === STORAGE ===
STORAGE_BUCKET_TENDER_DOCS=tender-documents
STORAGE_BUCKET_COMPANY_ASSETS=company-assets
STORAGE_BUCKET_EXPORTS=exported-documents
STORAGE_SIGNED_URL_EXPIRY=3600

# === FILE UPLOAD ===
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# === MONITORING ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# === RATE LIMITING ===
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AI_OPS=10/minute
RATE_LIMIT_UPLOADS=5/minute
RATE_LIMIT_AUTH=20/minute

# === CORS ===
CORS_ORIGINS=http://localhost:3000
